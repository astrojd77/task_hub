# Copy to .env and adjust. Never commit .env.

# ---------------------------------------------------------------- core
APP_NAME="Task Hub"
ENVIRONMENT=dev
DEBUG=true

# ------------------------------------------------------------ database
# Dev (default, zero setup):
DATABASE_URL=sqlite+pysqlite:///./task_hub.db
# Dev (Postgres via docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://taskhub:taskhub@localhost:5432/taskhub
# Migration check against the prod dialect (docker compose --profile oracle up -d oracle):
# DATABASE_URL=oracle+oracledb://taskhub:taskhub@localhost:1521/?service_name=FREEPDB1
# Prod (python-oracledb thin mode — no Oracle client install needed):
# DATABASE_URL=oracle+oracledb://USER:PASSWORD@HOST:1521/?service_name=YOUR_SERVICE
DB_ECHO=false

# ---------------------------------------------------------------- http
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------- providers
# Enabling an adapter is config, not code.
ENABLED_SOURCES=csv,jira,email
ENABLED_DESTINATIONS=local,jira
