# Copy to .env and adjust. Never commit .env.

# ---------------------------------------------------------------- core
APP_NAME="Task Hub"
ENVIRONMENT=dev
DEBUG=true

# ------------------------------------------------------------ database
# Dev (default, zero setup):
DATABASE_URL=sqlite+pysqlite:///./task_hub.db
# Dev (Postgres via docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://taskhub:taskhub@localhost:5432/taskhub
# Migration check against the prod dialect (docker compose --profile oracle up -d oracle):
# DATABASE_URL=oracle+oracledb://taskhub:taskhub@localhost:1521/?service_name=FREEPDB1
# Prod (python-oracledb thin mode — no Oracle client install needed):
# DATABASE_URL=oracle+oracledb://USER:PASSWORD@HOST:1521/?service_name=YOUR_SERVICE
DB_ECHO=false

# ---------------------------------------------------------------- http
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------- providers
# Enabling an adapter is config, not code.
ENABLED_SOURCES=csv,jira,email
ENABLED_DESTINATIONS=local,jira

# ------------------------------------------------------------- serving
# Directory holding the built frontend. When it exists the API also serves the
# SPA (that is how the container image ships). Leave as-is for local dev, where
# the directory is absent and Vite serves the frontend instead.
STATIC_DIR=static

# ---------------------------------------------------------------- jira
# Credentials are server-side only — the browser never sees or sends them.
# Leave blank and drop "jira" from ENABLED_SOURCES/ENABLED_DESTINATIONS if unused.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Where pushed issues get created.
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Optional: Jira custom fields carrying criticality / impact, e.g.
# customfield_10042. Left blank, the review popup asks for them instead, and
# pushes record them as taskhub-crit-* / taskhub-impact-* labels.
JIRA_CRITICALITY_FIELD=
JIRA_IMPACT_FIELD=

# Ceiling on a single JQL fetch. Targeted imports only — never a blanket pull.
JIRA_MAX_RESULTS=100
