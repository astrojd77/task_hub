# ------------------------------------------------------- local test data
# Real work items and saved emails are not sample data — keep them out.
# examples/ is curated and tracked.
*.eml
*.msg
!examples/**/*.eml
!examples/**/*.msg
/tmp/
scratch/
.scratch/

# ------------------------------------------------------------- container
# Compose override files are per-developer by convention.
docker-compose.override.yml
.docker/

