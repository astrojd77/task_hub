# ---------------------------------------------------------------- secrets
# Never commit a real environment file. .env.example is the template and is
# tracked deliberately.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
credentials.json
secrets.yaml
secret.yaml
# ...but the OpenShift reference template is documentation, not a secret.
!deploy/openshift/base/secret.example.yaml

